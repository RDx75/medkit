---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Privacy" description="MedKit privacy policy — no tracking, no uploads.">
  <h1>Privacy Policy</h1>
  <p style="color:var(--text-dim);max-width:640px">MedKit is a static website. It does not collect personal information, set advertising cookies, or transmit anything you type to a server.</p>
  <h2>What stays on your device</h2>
  <ul style="color:var(--text-dim)">
    <li>Tool inputs and results — computed locally in your browser.</li>
    <li>Theme preference — saved in <code>localStorage</code> on your device only.</li>
  </ul>
  <h2>What we do not do</h2>
  <ul style="color:var(--text-dim)">
    <li>No accounts, no login, no analytics scripts.</li>
    <li>No third-party advertising or tracking pixels.</li>
    <li>No storage of quiz answers or calculator history.</li>
  </ul>
  <p style="color:var(--text-dim)">Essential cookies are limited to what the browser needs to serve the page. You can decline optional cookies via the cookie banner.</p>
</Base>
