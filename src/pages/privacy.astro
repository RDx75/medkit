---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Privacy" description="MedKit privacy policy — no tracking, no uploads.">
  <h1 data-i18n="privacy.h1">Privacy Policy</h1>
  <p style="color:var(--text-dim);max-width:640px" data-i18n="privacy.p1">MedKit is a static website. It does not collect personal information, set advertising cookies, or transmit anything you type to a server.</p>
  <h2 data-i18n="privacy.h2">What stays on your device</h2>
  <ul style="color:var(--text-dim)">
    <li data-i18n="privacy.l1">Tool inputs and results — computed locally in your browser.</li>
    <li data-i18n="privacy.l2">Theme preference — saved in <code>localStorage</code> on your device only.</li>
  </ul>
  <h2 data-i18n="privacy.h3">What we do not do</h2>
  <ul style="color:var(--text-dim)">
    <li data-i18n="privacy.l3">No accounts, no login, no analytics scripts.</li>
    <li data-i18n="privacy.l4">No third-party advertising or tracking pixels.</li>
    <li data-i18n="privacy.l5">No storage of quiz answers or calculator history.</li>
  </ul>
  <p style="color:var(--text-dim)" data-i18n="privacy.p2">Essential cookies are limited to what the browser needs to serve the page. You can decline optional cookies via the cookie banner.</p>
</Base>
