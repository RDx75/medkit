---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Terms" description="MedKit terms of service — education only, not medical advice.">
  <h1 data-i18n="terms.h1">Terms of Service</h1>
  <p style="color:var(--text-dim);max-width:640px" data-i18n="terms.p1">By using MedKit you agree to the following:</p>
  <h2 data-i18n="terms.h2">Not medical advice</h2>
  <p style="color:var(--text-dim)" data-i18n="terms.p2">MedKit provides calculators, references and study aids for education and quick reference. It is <strong>not</strong> a substitute for professional medical advice, diagnosis or treatment. Always follow your institution's protocols and the direction of qualified clinicians.</p>
  <h2 data-i18n="terms.h3">No warranty</h2>
  <p style="color:var(--text-dim)" data-i18n="terms.p3">Tools are provided "as is" without warranty of accuracy or fitness for any purpose. Verify all results against authoritative sources before clinical use.</p>
  <h2 data-i18n="terms.h4">Liability</h2>
  <p style="color:var(--text-dim)" data-i18n="terms.p4">The operators of MedKit are not liable for any outcome arising from the use of this site.</p>
  <div class="callout danger" data-i18n="terms.warn">In a medical emergency, call your local emergency number immediately.</div>
</Base>
