---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="About" description="About MedKit — free, private, browser-local medical tools.">
  <h1 data-i18n="about.h1">About MedKit</h1>
  <p style="color:var(--text-dim);max-width:640px" data-i18n="about.p1">MedKit is a collection of free, fast medical calculators, references and study aids. Every tool runs entirely in your browser — no account, no uploads, no tracking. It is built in the spirit of developer toolboxes like HubKit, but for clinical and student use.</p>
  <p style="color:var(--text-dim);max-width:640px" data-i18n="about.p2">The project is a personal study companion for EMT training and bedside reference. Content is reviewed against standard guidelines but is for education only.</p>
  <h2 data-i18n="about.h2">Principles</h2>
  <ul style="color:var(--text-dim)">
    <li data-i18n="about.l1"><strong>Private by default</strong> — calculations never leave your device.</li>
    <li data-i18n="about.l2"><strong>Fast &amp; offline-friendly</strong> — static site, instant load.</li>
    <li data-i18n="about.l3"><strong>Open structure</strong> — easy to add tools and sync with your notes.</li>
  </ul>
  <div class="callout danger" data-i18n="about.warn">MedKit is not a substitute for professional medical judgment. In an emergency, call your local emergency number.</div>
</Base>
