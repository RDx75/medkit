---
import Base from '../../layouts/Base.astro';
import { questions, quizCategories } from '../../data/questions';

const base = import.meta.env.BASE_URL;
---
<Base title="EMT Quiz" activeSlug="quiz">
  <div class="breadcrumb"><a href={base}>MedKit</a> / Study / <span>EMT Quiz</span></div>
  <h1 data-i18n="quiz.h1">EMT Quiz</h1>
  <p class="cat-desc" data-i18n="quiz.desc">Practice questions drawn from your EMT study notes. Your answers stay on this device.</p>

  <div class="tool-ui">
    <!-- Setup panel -->
    <div id="setup">
      <div class="field">
        <label data-i18n="quiz.cat_label">Category</label>
        <select id="catSel">
          <option value="all" data-i18n="quiz.cat_all">All topics</option>
          {quizCategories.map((c) => (
            <option value={c.id}>{c.emoji} <span data-i18n={`quiz.cat.${c.id}`}>{c.id}</span></option>
          ))}
        </select>
      </div>
      <div class="field">
        <label data-i18n="quiz.count_label">Number of questions</label>
        <select id="countSel">
          <option value="10">10</option>
          <option value="15">15</option>
          <option value="20" selected>20</option>
          <option value="0" data-i18n="quiz.count_all">All</option>
        </select>
      </div>
      <button class="btn" id="startBtn" data-i18n="quiz.start">Start quiz</button>
    </div>

    <div id="quiz" style="display:none"></div>
    <div id="score" class="result" style="display:none"></div>
    <div style="margin-top:14px">
      <button class="btn" id="restart" style="display:none" data-i18n="quiz.restart">Restart quiz</button>
      <button class="btn btn-ghost" id="back" style="display:none" data-i18n="quiz.back">Change settings</button>
    </div>
  </div>

  <div class="article">
    <h2 data-i18n="quiz.about_h2">About this quiz</h2>
    <p data-i18n="quiz.about">These questions are drawn from your EMT study notes, grouped by topic. Each round is shuffled so you get a fresh set every time.</p>
    <div class="callout" data-i18n="quiz.note">Quiz progress is not uploaded. This is for self-testing only — always confirm answers against your course material and instructor.</div>
  </div>

  <script is:inline define:vars={{ questions }} data-astro-rerun>
    // Fisher–Yates shuffle — fresh order every round
    function shuffle(arr) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    const setup = document.getElementById('setup');
    const catSel = document.getElementById('catSel');
    const countSel = document.getElementById('countSel');
    const quizEl = document.getElementById('quiz');
    const scoreEl = document.getElementById('score');
    const restartBtn = document.getElementById('restart');
    const backBtn = document.getElementById('back');
    let deck = [], current = 0, correct = 0, answered = false;

    function t(k) { return window.__t ? window.__t(k) : k; }

    function render() {
      if (current >= deck.length) {
        quizEl.innerHTML = '';
        quizEl.style.display = 'none';
        scoreEl.style.display = 'block';
        scoreEl.innerHTML = `<span class="big">${correct}/${deck.length}</span> ${t('quiz.correct')}`;
        restartBtn.style.display = 'inline-block';
        backBtn.style.display = 'inline-block';
        return;
      }
      const item = deck[current];
      answered = false;
      quizEl.style.display = 'block';
      quizEl.innerHTML = `
        <p style="font-weight:600;margin-bottom:12px">${current + 1}. ${item.q}</p>
        <div class="opts" id="opts">
          ${item.options.map((o, i) => `<button class="opt" data-i="${i}">${o}</button>`).join('')}
        </div>
        <div id="fb" class="callout" style="display:none;margin-top:14px"></div>`;
      document.getElementById('opts').addEventListener('click', onAnswer);
    }

    function onAnswer(e) {
      if (answered) return;
      const btn = e.target.closest('.opt');
      if (!btn) return;
      answered = true;
      const i = parseInt(btn.dataset.i, 10);
      const item = deck[current];
      const opts = [...document.querySelectorAll('#opts .opt')];
      opts.forEach((b) => b.classList.add('disabled'));
      if (i === item.answer) { btn.classList.add('active'); correct++; }
      else { btn.style.borderColor = 'var(--danger)'; opts[item.answer].classList.add('active'); }
      const fb = document.getElementById('fb');
      fb.style.display = 'block';
      fb.className = 'callout ' + (i === item.answer ? '' : 'danger');
      fb.innerHTML = (i === item.answer ? '✅ ' + t('quiz.correct_short') + ' ' : '❌ ' + t('quiz.wrong_short') + ' ') + item.explain;
      setTimeout(() => { current++; render(); }, 1600);
    }

    function start() {
      const cat = catSel.value;
      const max = parseInt(countSel.value, 10) || 0;
      const pool = cat === 'all' ? questions : questions.filter((q) => q.cat === cat);
      if (!pool.length) {
        quizEl.style.display = 'block';
        quizEl.innerHTML = `<div class="callout danger">${t('quiz.noq')}</div>`;
        return;
      }
      deck = shuffle(pool);
      if (max > 0 && deck.length > max) deck = deck.slice(0, max);
      current = 0; correct = 0;
      setup.style.display = 'none';
      scoreEl.style.display = 'none';
      restartBtn.style.display = 'none';
      backBtn.style.display = 'none';
      render();
    }

    document.getElementById('startBtn').addEventListener('click', start);
    restartBtn.addEventListener('click', () => {
      deck = shuffle(deck); // reshuffle same pool
      current = 0; correct = 0;
      scoreEl.style.display = 'none';
      restartBtn.style.display = 'none';
      backBtn.style.display = 'none';
      render();
    });
    backBtn.addEventListener('click', () => {
      setup.style.display = 'block';
      quizEl.style.display = 'none';
      scoreEl.style.display = 'none';
      restartBtn.style.display = 'none';
      backBtn.style.display = 'none';
    });
  </script>
</Base>
