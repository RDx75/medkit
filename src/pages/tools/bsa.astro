---
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="BSA Calculator" activeSlug="bsa">
  <div class="breadcrumb"><a href={base}>MedKit</a> / <span data-i18n="cat.calculators.title">Calculators</span> / <span data-i18n="tools.bsa.title">BSA Calculator</span></div>
  <h1 data-i18n="bsa.h1">BSA Calculator</h1>
  <p class="cat-desc" data-i18n="bsa.desc">Body Surface Area via the Mosteller formula (m²).</p>

  <div class="tool-ui">
    <div class="row">
      <div class="field">
        <label data-i18n="bsa.ht">Height (cm)</label>
        <input id="ht" type="number" value="170" min="0" step="0.1" />
      </div>
      <div class="field">
        <label data-i18n="bsa.wt">Weight (kg)</label>
        <input id="wt" type="number" value="70" min="0" step="0.1" />
      </div>
    </div>
    <button class="btn" id="calc" data-i18n="bsa.calc">Calculate</button>
    <div class="result" id="out" data-i18n="bsa.enter">Enter values and press Calculate.</div>
  </div>

  <div class="article">
    <h2 data-i18n="bsa.h2">Free Online BSA Calculator</h2>
    <p data-i18n="bsa.intro">Body Surface Area (BSA) estimates the total skin surface area of the body. It is commonly used to calculate drug doses (especially chemotherapeutics) and fluid requirements. The Mosteller formula is the most widely used bedside estimate:</p>
    <p><code>BSA (m²) = √[ (height(cm) × weight(kg)) / 3600 ]</code></p>
    <h3 data-i18n="bsa.h3_val">Typical Values</h3>
    <table>
      <tr><th>Group</th><th>Approx. BSA</th></tr>
      <tr><td>Adult (average)</td><td>1.7 m²</td></tr>
      <tr><td>Child (10 yr)</td><td>1.1 m²</td></tr>
      <tr><td>Neonate</td><td>0.25 m²</td></tr>
    </table>
    <h3 data-i18n="bsa.h3_faq">Frequently Asked Questions</h3>
    <details class="faq"><summary data-i18n="bsa.faq1q">Why use BSA for dosing?</summary><div class="body" data-i18n="bsa.faq1a">Many pharmacokinetic studies normalise clearance to BSA, so weight-based drugs (e.g. many oncology agents) are dosed per m² to reduce interpatient variability.</div></details>
    <div class="callout danger" data-i18n="bsa.warn">Always confirm the institution's dosing protocol and maximum dose before administering BSA-based medication.</div>
  </div>

  <script is:inline data-astro-rerun>
    const out = document.getElementById('out');
    const t = (k) => window.__t(k);
    function run() {
      const ht = parseFloat(document.getElementById('ht').value);
      const wt = parseFloat(document.getElementById('wt').value);
      if (!ht || !wt) { out.textContent = t('bsa.enter_both'); return; }
      const bsa = Math.sqrt((ht * wt) / 3600);
      out.innerHTML = `<span class="big">${bsa.toFixed(2)}</span> ${t('bsa.result')}`;
    }
    document.getElementById('calc').addEventListener('click', run);
    document.getElementById('ht').addEventListener('input', run);
    document.getElementById('wt').addEventListener('input', run);
    document.addEventListener('i18n:changed', run);
    run();
  </script>
</Base>
