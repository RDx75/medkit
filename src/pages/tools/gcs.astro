---
import Base from '../../layouts/Base.astro';
---

<Base title="GCS Calculator" activeSlug="gcs">
  <div class="breadcrumb"><a href="/">MedKit</a> / Calculators / <span>GCS Calculator</span></div>
  <h1>GCS Calculator</h1>
  <p class="cat-desc">Glasgow Coma Scale — Eye, Verbal, Motor summed to a score of 3–15.</p>

  <div class="tool-ui">
    <div class="field">
      <label>Eye Opening (E)</label>
      <div class="opts" id="eye">
        <button class="opt" data-v="4">4 · Spontaneous</button>
        <button class="opt" data-v="3">3 · To speech</button>
        <button class="opt" data-v="2">2 · To pain</button>
        <button class="opt" data-v="1">1 · None</button>
      </div>
    </div>
    <div class="field">
      <label>Verbal Response (V)</label>
      <div class="opts" id="verbal">
        <button class="opt" data-v="5">5 · Oriented</button>
        <button class="opt" data-v="4">4 · Confused</button>
        <button class="opt" data-v="3">3 · Words</button>
        <button class="opt" data-v="2">2 · Sounds</button>
        <button class="opt" data-v="1">1 · None</button>
      </div>
    </div>
    <div class="field">
      <label>Motor Response (M)</label>
      <div class="opts" id="motor">
        <button class="opt" data-v="6">6 · Obeys</button>
        <button class="opt" data-v="5">5 · Localises</button>
        <button class="opt" data-v="4">4 · Withdraws</button>
        <button class="opt" data-v="3">3 · Flexion</button>
        <button class="opt" data-v="2">2 · Extension</button>
        <button class="opt" data-v="1">1 · None</button>
      </div>
    </div>
    <div class="result" id="out">Select a response in each row.</div>
  </div>

  <div class="article">
    <h2>Free Online Glasgow Coma Scale Calculator</h2>
    <p>The GCS is a neurological scale that assesses a person's level of consciousness after a brain injury. It sums three components — Eye, Verbal and Motor — for a total between 3 (deep coma) and 15 (fully alert).</p>
    <h3>Interpretation</h3>
    <table>
      <tr><th>Total</th><th>Category</th></tr>
      <tr><td>13–15</td><td>Mild impairment</td></tr>
      <tr><td>9–12</td><td>Moderate impairment</td></tr>
      <tr><td>3–8</td><td>Severe — consider intubation</td></tr>
    </table>
    <p class="callout danger">In intubated or aphasic patients, record "NT" (not testable) for the verbal component and document the reason. A GCS ≤ 8 typically warrants airway protection.</p>
    <h3>FAQ</h3>
    <details class="faq"><summary>Can I use GCS in children?</summary><div class="body">The standard GCS applies to older children and adults. Infants use a paediatric adaptation where the verbal scale is replaced by a "best verbal/irritability" scale.</div></details>
  </div>

  <script is:inline>
    const out = document.getElementById('out');
    const groups = ['eye', 'verbal', 'motor'];
    function score() {
      let total = 0, done = true;
      groups.forEach((g) => {
        const active = document.querySelector(`#${g} .opt.active`);
        if (active) total += parseInt(active.dataset.v, 10);
        else done = false;
      });
      if (!done) { out.textContent = 'Select a response in each row.'; return; }
      let cls = 'ok', label = 'Mild';
      if (total <= 8) { cls = 'bad'; label = 'Severe'; }
      else if (total <= 12) { cls = 'warn'; label = 'Moderate'; }
      out.innerHTML = `<span class="big">${total}</span> / 15 <span class="tag tag-${cls}">${label}</span>`;
    }
    groups.forEach((g) => {
      document.getElementById(g).addEventListener('click', (e) => {
        const btn = e.target.closest('.opt');
        if (!btn) return;
        document.querySelectorAll(`#${g} .opt`).forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        score();
      });
    });
  </script>
</Base>
