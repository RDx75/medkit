---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import { categories, tools, refGroups, toolsByGroup } from '../data/tools';
import { translations } from '../data/i18n';

const base = import.meta.env.BASE_URL || '/';

interface Props {
  title: string;
  description?: string;
  activeSlug?: string;
}

const { title, description = 'Free, fast, privacy-first medical calculators and references. Everything runs locally in your browser.', activeSlug } = Astro.props;

// Pre-compute search data: tools (title+desc) + reference text (from translations if available)
const toolSearch = tools.map((t) => ({
  path: t.path,
  title: t.title,
  desc: t.description,
  emoji: t.emoji,
  cat: t.category,
  type: 'tool',
}));

// Flatten reference pages from search-index.json (generated by generate_refs.py)
// Fallback: if no index, just use tool titles
const refSearch = tools
  .filter((t) => t.category === 'references')
  .map((t) => ({ path: t.path, title: t.title, desc: t.description, emoji: t.emoji, cat: t.category, type: 'ref' }));

const allSearch = [...toolSearch, ...refSearch];
---

<!doctype html>
<html lang="en" data-theme="dark" data-accent="sky" data-font="sans" data-fontscale="md">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <ViewTransitions />
    <title>{title} — MedKit</title>

    <!-- Pre-paint: theme + lang + accent + font (no flash) -->
    <script is:inline define:vars={{ translations }}>
      // ===== i18n (MUST be in head — before any tool script runs) =====
      const I18N = translations;
      window.__lang = 'en';
      try { window.__lang = localStorage.getItem('lang') || 'en'; } catch (e) {}
      window.__t = (k) => (I18N[window.__lang] && I18N[window.__lang][k]) || (I18N.en && I18N.en[k]) || k;
      window.__applyI18n = function () {
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const k = el.getAttribute('data-i18n');
          const v = window.__t(k);
          if (v) el.textContent = v;
        });
        document.documentElement.lang = window.__lang;
        const sp = document.getElementById('searchInput');
        if (sp) sp.placeholder = window.__t('search.placeholder');
        const lbtn = document.getElementById('langToggle');
        if (lbtn) lbtn.textContent = window.__lang === 'th' ? '🇬🇧' : '🇹🇭';
        document.dispatchEvent(new CustomEvent('i18n:changed'));
      };

      // ===== Theme =====
      try { var th = localStorage.getItem('theme'); if (th) document.documentElement.setAttribute('data-theme', th); } catch (e) {}
      try { var ac = localStorage.getItem('accent'); if (ac) document.documentElement.setAttribute('data-accent', ac); } catch (e) {}
      try { var fn = localStorage.getItem('font'); if (fn) document.documentElement.setAttribute('data-font', fn); } catch (e) {}
      try { var fs = localStorage.getItem('fontscale'); if (fs) document.documentElement.setAttribute('data-fontscale', fs); } catch (e) {}

      // ===== Language toggle =====
      window.__toggleLang = function () {
        window.__lang = window.__lang === 'th' ? 'en' : 'th';
        try { localStorage.setItem('lang', window.__lang); } catch (e) {}
        window.__applyI18n();
      };
    </script>
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <a class="brand" href={base}>
          <span class="logo">⚕️</span>
          <span>MedKit<span class="sub" data-i18n="app.tagline"> medical tools</span></span>
        </a>
        <button class="search-btn" id="searchTrigger">
          <span data-i18n="search.label">Search</span><kbd>⌘K</kbd>
        </button>
        <div class="header-controls">
          <button class="icon-btn" id="fontDec" title="Smaller font" aria-label="Decrease font">A−</button>
          <button class="icon-btn" id="fontInc" title="Larger font" aria-label="Increase font">A+</button>
          <button class="icon-btn accent-btn" id="accentToggle" title="Change accent color" aria-label="Change accent color">🎨</button>
          <button class="icon-btn" id="fontToggle" title="Change font family" aria-label="Change font family">🔤</button>
          <button class="icon-btn" id="langToggle" title="ภาษา / Language" onclick="window.__toggleLang()">🇹🇭</button>
          <button class="icon-btn" id="themeToggle" title="Toggle theme" aria-label="Toggle theme">🌙</button>
        </div>
      </header>

      <div class="page">
        <aside class="sidebar" id="sidebar">
          {categories.map((c) => (
            <div class="side-group" data-cat={c.id}>
              <h4 data-i18n={`cat.${c.id}.title`}>{c.title}</h4>
              {c.id === 'references' ? (
                /* References: grouped with collapsible sub-sections */
                refGroups.map((g) => {
                  const items = toolsByGroup(g.id);
                  return items.length > 0 ? (
                    <details class="side-sub" open>
                      <summary><span class="sub-emoji">{g.emoji}</span><span data-i18n={`group.${g.id}.title`}>{g.title}</span></summary>
                      {items.map((t) => (
                        <a class={`side-link ${activeSlug === t.slug ? 'active' : ''}`} href={`${base}${t.path}/`}>
                          <span class="ico">{t.emoji}</span>{t.title}
                        </a>
                      ))}
                    </details>
                  ) : null;
                })
              ) : (
                /* Calculators / Study: flat list */
                tools.filter((t) => t.category === c.id).map((t) => (
                  <a class={`side-link ${activeSlug === t.slug ? 'active' : ''}`} href={`${base}${t.path}/`}>
                    <span class="ico">{t.emoji}</span>{t.title}
                  </a>
                ))
              )}
            </div>
          ))}
        </aside>

        <main class="main">
          <slot />
        </main>
      </div>

      <footer class="footer">
        <span data-i18n="footer.brand">⚕️ MedKit.dev</span>
        <a href={`${base}about/`} data-i18n="footer.about">About</a>
        <a href={`${base}privacy/`} data-i18n="footer.privacy">Privacy</a>
        <a href={`${base}terms/`} data-i18n="footer.terms">Terms</a>
        <span class="spacer"></span>
        <span class="disclaimer" data-i18n="footer.disclaimer">For education &amp; reference only — not a substitute for professional medical advice.</span>
      </footer>
    </div>

    <!-- ⌘K command palette with full-text search -->
    <div class="modal-backdrop" id="searchModal">
      <div class="modal">
        <input id="searchInput" type="text" placeholder="Search tools, references…" autocomplete="off" />
        <div class="modal-tabs">
          <button class="tab active" data-tab="all" data-i18n="search.tab_all">All</button>
          <button class="tab" data-tab="tool" data-i18n="search.tab_tools">Tools</button>
          <button class="tab" data-tab="ref" data-i18n="search.tab_refs">References</button>
        </div>
        <div class="modal-results" id="searchResults"></div>
      </div>
    </div>

    <script is:inline define:vars={{ allSearch, base }} data-astro-rerun>
      // ---- Theme toggle ----
      const themeBtn = document.getElementById('themeToggle');
      function syncThemeIcon() {
        themeBtn.textContent = document.documentElement.getAttribute('data-theme') === 'light' ? '☀️' : '🌙';
      }
      syncThemeIcon();
      themeBtn.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme');
        const next = cur === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        syncThemeIcon();
      });

      // ---- Font size toggle ----
      const scales = ['sm', 'md', 'lg', 'xl'];
      function setFontScale(dir) {
        let cur = document.documentElement.getAttribute('data-fontscale') || 'md';
        let idx = scales.indexOf(cur);
        idx = Math.max(0, Math.min(scales.length - 1, idx + dir));
        const ns = scales[idx];
        document.documentElement.setAttribute('data-fontscale', ns);
        try { localStorage.setItem('fontscale', ns); } catch (e) {}
      }
      document.getElementById('fontDec').addEventListener('click', () => setFontScale(-1));
      document.getElementById('fontInc').addEventListener('click', () => setFontScale(1));

      // ---- Accent color cycle ----
      const accents = ['sky', 'green', 'violet', 'amber', 'rose'];
      document.getElementById('accentToggle').addEventListener('click', () => {
        let cur = document.documentElement.getAttribute('data-accent') || 'sky';
        let idx = accents.indexOf(cur);
        idx = (idx + 1) % accents.length;
        const na = accents[idx];
        document.documentElement.setAttribute('data-accent', na);
        try { localStorage.setItem('accent', na); } catch (e) {}
      });

      // ---- Font family cycle ----
      const fonts = ['sans', 'serif', 'mono'];
      document.getElementById('fontToggle').addEventListener('click', () => {
        let cur = document.documentElement.getAttribute('data-font') || 'sans';
        let idx = fonts.indexOf(cur);
        idx = (idx + 1) % fonts.length;
        const nf = fonts[idx];
        document.documentElement.setAttribute('data-font', nf);
        try { localStorage.setItem('font', nf); } catch (e) {}
      });

      // ---- Search palette (with full-text) ----
      const modal = document.getElementById('searchModal');
      const input = document.getElementById('searchInput');
      const results = document.getElementById('searchResults');
      const trigger = document.getElementById('searchTrigger');
      let cursor = -1;
      let activeTab = 'all';
      let refIndex = null; // full-text index (loaded lazily)

      async function loadRefIndex() {
        if (refIndex !== null) return;
        try {
          const res = await fetch(`${base}search-index.json`);
          refIndex = await res.json();
        } catch (e) {
          refIndex = []; // fallback: no full-text, just titles
        }
      }

      function searchAll(q) {
        const query = q.trim().toLowerCase();
        if (!query) return allSearch.slice(0, 12);
        // Phase 1: title/desc match (instant)
        const titleHits = allSearch.filter((t) =>
          (t.title + ' ' + t.desc).toLowerCase().includes(query)
        );
        // Phase 2: full-text ref match
        let textHits = [];
        if (refIndex && refIndex.length) {
          refIndex.forEach((r) => {
            if (r.text && r.text.toLowerCase().includes(query)) {
              // skip if already in titleHits
              if (!titleHits.find((t) => t.path === r.path)) {
                // find snippet position
                const idx = r.text.toLowerCase().indexOf(query);
                const start = Math.max(0, idx - 40);
                const snippet = r.text.substring(start, idx + 80).trim();
                textHits.push({ path: r.path, title: r.title, emoji: r.emoji, cat: 'references', type: 'ref', desc: '…' + snippet + '…' });
              }
            }
          });
        }
        return [...titleHits, ...textHits].slice(0, 20);
      }

      function render(q) {
        let list = searchAll(q);
        if (activeTab !== 'all') list = list.filter((t) => t.type === activeTab);
        cursor = -1;
        if (!list.length) {
          results.innerHTML = '<div class="modal-empty">' + (window.__t('search.empty')) + '</div>';
          return;
        }
        results.innerHTML = list
          .map((t, i) => `<a href="${base}${t.path}/" data-i="${i}"><span class="ico">${t.emoji}</span><div><span class="title">${t.title}</span>${t.desc ? '<span class="snippet">' + t.desc.substring(0, 80) + '</span>' : ''}</div><span class="cat-tag">${(t.cat || '').toUpperCase()}</span></a>`)
          .join('');
      }

      function openModal() {
        modal.classList.add('open');
        input.value = '';
        loadRefIndex().then(() => render(''));
        input.focus();
      }
      function closeModal() { modal.classList.remove('open'); }

      trigger.addEventListener('click', openModal);
      modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      input.addEventListener('input', () => render(input.value));
      input.addEventListener('keydown', (e) => {
        const items = [...results.querySelectorAll('a')];
        if (e.key === 'ArrowDown') { cursor = Math.min(cursor + 1, items.length - 1); }
        else if (e.key === 'ArrowUp') { cursor = Math.max(cursor - 1, 0); }
        else if (e.key === 'Enter') { if (items[cursor]) items[cursor].click(); return; }
        else return;
        items.forEach((el, i) => el.classList.toggle('cursor', i === cursor));
        if (items[cursor]) items[cursor].scrollIntoView({ block: 'nearest' });
      });

      // Tab switching
      document.querySelectorAll('.modal-tabs .tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.modal-tabs .tab').forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          activeTab = tab.dataset.tab;
          render(input.value);
        });
      });

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openModal(); }
        else if (e.key === 'Escape') { closeModal(); }
      });

      // Apply i18n on load
      window.__applyI18n();

      // ---- Prevent "jump to top" when clicking a link to the CURRENT page ----
      // (e.g. tapping the active sidebar item reloads the page and scrolls up)
      document.addEventListener('click', (e) => {
        const a = e.target.closest('a[href]');
        if (!a) return;
        try {
          const u = new URL(a.href, location.href);
          if (u.origin === location.origin && u.pathname === location.pathname && !u.hash) {
            e.preventDefault();
          }
        } catch (err) { /* ignore malformed href */ }
      });

      // ---- Sidebar: keep its scroll position across View Transitions ----
      // The sidebar is a long sticky column; when the user scrolls it to reach
      // a lower item and clicks, we don't want it to snap back to the top.
      const SB_KEY = 'medkit_sidebar_scroll';
      document.addEventListener('astro:before-swap', () => {
        const sb = document.getElementById('sidebar');
        if (sb) {
          try { sessionStorage.setItem(SB_KEY, String(sb.scrollTop)); } catch (e) {}
        }
      });
      document.addEventListener('astro:after-swap', () => {
        const sb = document.getElementById('sidebar');
        if (sb) {
          const saved = parseInt(sessionStorage.getItem(SB_KEY) || '0', 10) || 0;
          requestAnimationFrame(() => { sb.scrollTop = saved; });
        }
      });
    </script>
  </body>
</html>
